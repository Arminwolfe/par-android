<?xml version="1.0" encoding="utf-8"?>
<!-- SHABAKEH PAR hosts speak plain HTTP/WebSocket (TLS is not implemented yet), so cleartext must be allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
